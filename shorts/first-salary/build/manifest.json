 "cues": [
  {
   "start": 0.1,
   "end": 2.7,
   "text": "첫 월급, 받자마자\n뭐부터 해야 할까요?"
  },
  {
   "start": 2.8,
   "end": 4.0,
   "text": "딱 세 가지만 기억하세요"
  },
  {
   "start": 4.2,
   "end": 6.6,
   "text": "첫째, 비상금 통장부터 만드세요"
  },
  {
   "start": 6.8,
   "end": 9.2,
   "text": "생활비 3에서 6개월 치를\n따로 모아 두는 거예요"
  },
  {
   "start": 9.4,
   "end": 11.6,
   "text": "언제든 꺼낼 수 있는\n파킹통장에 두면 좋아요"
  },
  {
   "start": 11.8,
   "end": 15.0,
   "text": "둘째, 저축은 월급날\n자동이체로 먼저 하세요"
  },
  {
   "start": 15.2,
   "end": 17.2,
   "text": "쓰고 남은 돈을 모으면\n남는 돈이 없거든요"
  },
  {
   "start": 17.4,
   "end": 19.4,
   "text": "셋째, 카드는 나눠서 쓰세요"
  },
  {
   "start": 19.6,
   "end": 23.4,
   "text": "연말정산에서 카드 공제는\n총급여의 25%를 넘게\n쓴 부분부터예요"
  },
  {
   "start": 23.6,
   "end": 26.8,
   "text": "그다음부터는 공제율이 두 배인\n체크카드가 유리하죠"
  },
  {
   "start": 27.0,
   "end": 30.6,
   "text": "퀴즈! 총급여가 3천만 원이면\n얼마부터 카드 공제가 시작될까?"
  },
  {
   "start": 31.4,
   "end": 33.2,
   "text": "정답은, 750만 원이에요!"
  },
  {
   "start": 33.4,
   "end": 36.2,
   "text": "3천만 원의 25%를\n넘게 쓴 돈부터예요"
  },
  {
   "start": 36.6,
   "end": 39.6,
   "text": "첫 월급부터 습관을 만들면\n돈이 쌓이기 시작해요"
  },
  {
   "start": 40.0,
   "end": 42.4,
   "text": "더 많은 돈 이야기가 궁금하다면\n구독해 주세요"
  }
 ]
}