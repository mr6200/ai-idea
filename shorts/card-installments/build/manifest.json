 "cues": [
  {
   "start": 0.1,
   "end": 2.6,
   "text": "무이자 할부,\n카드사는 손해일까요?"
  },
  {
   "start": 2.6,
   "end": 4.8,
   "text": "이자도 안 받는데\n왜 해줄까요?"
  },
  {
   "start": 5.0,
   "end": 8.4,
   "text": "120만 원을\n3개월 무이자로 사면"
  },
  {
   "start": 8.4,
   "end": 11.8,
   "text": "매달 40만 원,\n이자는 0원이에요"
  },
  {
   "start": 12.0,
   "end": 15.6,
   "text": "그런데 가게는 며칠 뒤\n120만 원을 다 받아요"
  },
  {
   "start": 15.6,
   "end": 18.8,
   "text": "카드사가 먼저\n돈을 내주는 거죠"
  },
  {
   "start": 19.0,
   "end": 22.4,
   "text": "3개월 동안 빌려준 돈의 이자는"
  },
  {
   "start": 22.4,
   "end": 25.8,
   "text": "카드사가 대신 떠안아요.\n일부는 가게가 나눠 내고요"
  },
  {
   "start": 26.0,
   "end": 29.4,
   "text": "그래도 해주는 이유는\n미끼이기 때문이에요"
  },
  {
   "start": 29.4,
   "end": 32.8,
   "text": "무이자가 있으면\n그 카드를 더 많이 쓰게 되니까요"
  },
  {
   "start": 33.0,
   "end": 36.4,
   "text": "카드를 쓸 때마다\n가게는 수수료를 내요"
  },
  {
   "start": 36.4,
   "end": 39.8,
   "text": "이 가맹점 수수료가\n카드사의 기본 수입이에요"
  },
  {
   "start": 40.0,
   "end": 43.6,
   "text": "진짜 수익은 따로 있어요.\n이자가 붙는 할부"
  },
  {
   "start": 43.6,
   "end": 47.8,
   "text": "카드사 7곳이 지난해 할부 수수료로\n번 돈만 약 3조 6천억 원"
  },
  {
   "start": 48.0,
   "end": 51.4,
   "text": "리볼빙과 카드론도\n연 10%가 넘는 이자를 받아요"
  },
  {
   "start": 51.4,
   "end": 54.8,
   "text": "무이자로 들어와서,\n이자로 남는 거죠"
  },
  {
   "start": 55.0,
   "end": 58.6,
   "text": "그런데 금리가 오르자\n무이자 기간이 확 줄었어요"
  },
  {
   "start": 58.6,
   "end": 62.8,
   "text": "2022년 말엔 최장 12개월,\n요즘은 2~3개월이 대부분"
  },
  {
   "start": 63.0,
   "end": 66.6,
   "text": "카드사가 돈을 빌려 오는\n비용이 커졌기 때문이에요"
  },
  {
   "start": 66.6,
   "end": 69.8,
   "text": "무이자는 결국\n카드사의 마케팅 비용이에요"
  },
  {
   "start": 70.0,
   "end": 73.6,
   "text": "퀴즈! 300만 원을\n6개월 무이자로 사면 매달 얼마?"
  },
  {
   "start": 73.6,
   "end": 76.4,
   "text": "정답은 50만 원!"
  },
  {
   "start": 76.6,
   "end": 79.8,
   "text": "단, 무이자가 끝나면\n수수료가 붙는지 꼭 확인하세요"
  },
  {
   "start": 80.2,
   "end": 84.6,
   "text": "무이자는 공짜가 아니라\n카드사의 미끼예요"
  },
  {
   "start": 84.8,
   "end": 89.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}