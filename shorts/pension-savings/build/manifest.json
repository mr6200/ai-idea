 "cues": [
  {
   "start": 0.1,
   "end": 3.4,
   "text": "연말정산 때 최대 148만 원을\n돌려받는 통장이 있다면?"
  },
  {
   "start": 3.5,
   "end": 4.6,
   "text": "바로 연금저축이에요"
  },
  {
   "start": 4.8,
   "end": 8.6,
   "text": "연금저축은 한 해 600만 원,\nIRP와 합치면 900만 원까지"
  },
  {
   "start": 8.8,
   "end": 12.8,
   "text": "넣은 돈의 13.2%나 16.5%를\n세금에서 깎아 줘요"
  },
  {
   "start": 13.0,
   "end": 17.4,
   "text": "연봉 5,500만 원 이하라면 16.5%,\n그보다 많으면 13.2%예요"
  },
  {
   "start": 17.6,
   "end": 21.0,
   "text": "월 50만 원씩 600만 원을 넣으면\n최대 99만 원을 돌려받아요"
  },
  {
   "start": 21.2,
   "end": 24.0,
   "text": "세금을 내는 직장인이나\n자영업자에게 특히 유리해요"
  },
  {
   "start": 24.2,
   "end": 26.6,
   "text": "노후까지 오래 묶어 둘 수 있다면\n더 좋고요"
  },
  {
   "start": 26.8,
   "end": 30.6,
   "text": "하지만 55세 전에 깨면\n기타소득세 16.5%를 내야 해요"
  },
  {
   "start": 30.8,
   "end": 32.9,
   "text": "돌려받은 세금보다\n더 낼 수도 있어요"
  },
  {
   "start": 33.0,
   "end": 34.9,
   "text": "낸 세금이 없다면\n돌려받을 것도 없고요"
  },
  {
   "start": 35.2,
   "end": 38.8,
   "text": "퀴즈! 55세 이후 연금으로 받으면\n세금은 얼마일까?"
  },
  {
   "start": 39.6,
   "end": 42.6,
   "text": "정답은, 3.3에서 5.5%예요!"
  },
  {
   "start": 42.8,
   "end": 44.8,
   "text": "나이가 많을수록\n세율이 낮아져요"
  },
  {
   "start": 45.2,
   "end": 47.6,
   "text": "내 소득과 계획에 맞는지\n먼저 따져 보세요"
  },
  {
   "start": 48.0,
   "end": 50.6,
   "text": "더 많은 돈 이야기가 궁금하다면\n구독해 주세요"
  }
 ]
}