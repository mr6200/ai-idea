 "cues": [
  {
   "start": 0.1,
   "end": 2.6,
   "text": "1,200만 원이 생겼어요"
  },
  {
   "start": 2.6,
   "end": 4.9,
   "text": "어떻게 넣을까요?"
  },
  {
   "start": 5.1,
   "end": 7.6,
   "text": "한 번에 다 넣을까?"
  },
  {
   "start": 7.6,
   "end": 9.9,
   "text": "12달에 나눠 넣을까?"
  },
  {
   "start": 10.1,
   "end": 13.9,
   "text": "투자자들의 오래된 고민,\n적립식 vs 거치식"
  },
  {
   "start": 14.2,
   "end": 17.6,
   "text": "한 번에 다 넣는 게 거치식"
  },
  {
   "start": 17.6,
   "end": 21.8,
   "text": "1,200만 원을\n오늘 바로 투자해요"
  },
  {
   "start": 22.2,
   "end": 25.6,
   "text": "나눠 넣는 게 적립식"
  },
  {
   "start": 25.6,
   "end": 29.8,
   "text": "매달 100만 원씩 12달"
  },
  {
   "start": 30.2,
   "end": 33.4,
   "text": "적립식의 장점은\n평균 매입 단가"
  },
  {
   "start": 33.4,
   "end": 37.6,
   "text": "매달 30만 원씩, 주가가\n1만 원, 5천 원, 1만 원이면"
  },
  {
   "start": 37.6,
   "end": 41.8,
   "text": "30주, 60주, 30주,\n모두 120주를 삽니다"
  },
  {
   "start": 42.2,
   "end": 45.8,
   "text": "90만 원에 120주,\n한 주에 7,500원"
  },
  {
   "start": 45.8,
   "end": 49.8,
   "text": "평균 주가 8,333원보다\n싸게 샀죠"
  },
  {
   "start": 50.2,
   "end": 53.8,
   "text": "쌀 때는 많이,\n비쌀 때는 적게"
  },
  {
   "start": 53.8,
   "end": 57.8,
   "text": "저절로 이렇게\n사게 되거든요"
  },
  {
   "start": 58.2,
   "end": 61.2,
   "text": "그럼 적립식이\n항상 이길까요?"
  },
  {
   "start": 61.2,
   "end": 65.2,
   "text": "세계 최대 운용사 중 하나인\n뱅가드가 실제로 비교했어요"
  },
  {
   "start": 65.2,
   "end": 68.8,
   "text": "미국·영국·호주의\n수십 년 데이터로"
  },
  {
   "start": 69.2,
   "end": 72.8,
   "text": "결과는 한 번에 넣기가\n3번 중 2번 이겼습니다"
  },
  {
   "start": 72.8,
   "end": 76.6,
   "text": "2023년에 다시 분석해도\n결과는 같았어요"
  },
  {
   "start": 76.6,
   "end": 79.8,
   "text": "약 3번 중 2번"
  },
  {
   "start": 80.2,
   "end": 84.6,
   "text": "시장은 내리는 때보다\n오르는 때가 더 많아서"
  },
  {
   "start": 84.8,
   "end": 89.8,
   "text": "나눠 넣는 동안 기다리는 돈은\n그 상승을 놓치거든요"
  },
  {
   "start": 90.2,
   "end": 93.2,
   "text": "상황별로 볼까요?\n계속 오르면"
  },
  {
   "start": 93.2,
   "end": 97.2,
   "text": "한 번에 1,560만 원,\n나눠서 약 1,380만 원"
  },
  {
   "start": 97.2,
   "end": 99.8,
   "text": "거치식 승리"
  },
  {
   "start": 100.2,
   "end": 103.2,
   "text": "크게 떨어졌다\n회복하면"
  },
  {
   "start": 103.2,
   "end": 107.2,
   "text": "한 번에 본전 1,200만 원,\n나눠서 약 1,530만 원"
  },
  {
   "start": 107.2,
   "end": 109.8,
   "text": "적립식 승리"
  },
  {
   "start": 110.2,
   "end": 113.4,
   "text": "계속 떨어지면\n둘 다 손해지만"
  },
  {
   "start": 113.4,
   "end": 116.8,
   "text": "나눠 넣은 쪽이\n덜 잃어요"
  },
  {
   "start": 117.2,
   "end": 121.8,
   "text": "그래서 확률로는 거치식,\n마음 편하기로는 적립식"
  },
  {
   "start": 122.0,
   "end": 127.8,
   "text": "넣자마자 폭락해도\n버틸 수 있는지가 핵심이에요"
  },
  {
   "start": 128.2,
   "end": 131.8,
   "text": "참고로 월급으로\n매달 넣는 건"
  },
  {
   "start": 131.8,
   "end": 135.8,
   "text": "돈이 생기자마자 넣는 거라\n그대로 하면 돼요"
  },
  {
   "start": 136.2,
   "end": 139.4,
   "text": "퀴즈! 2만 원, 1만 원에\n20만 원씩 사면?"
  },
  {
   "start": 139.4,
   "end": 142.2,
   "text": "평균 단가는 13,333원!"
  },
  {
   "start": 142.4,
   "end": 145.8,
   "text": "평균 주가 1만 5천 원보다\n싸죠"
  },
  {
   "start": 146.2,
   "end": 149.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}