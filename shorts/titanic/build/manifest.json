 "cues": [
  {
   "start": 0.1,
   "end": 3.0,
   "text": "침몰하지 않는 배, 타이타닉은\n왜 가라앉았을까요?"
  },
  {
   "start": 3.0,
   "end": 4.8,
   "text": "단 2시간 40분 만에요"
  },
  {
   "start": 5.0,
   "end": 8.6,
   "text": "1912년 4월, 당시 세계 최대 여객선\n타이타닉이 첫 항해에 나섰어요"
  },
  {
   "start": 8.6,
   "end": 11.8,
   "text": "사람들은 거의 가라앉지 않는\n배라고 불렀죠"
  },
  {
   "start": 12.0,
   "end": 15.4,
   "text": "배 밑은 벽으로 나뉜\n16개의 방수 칸"
  },
  {
   "start": 15.4,
   "end": 18.8,
   "text": "앞쪽 네 칸까지는\n물이 차도 버티게 만들었죠"
  },
  {
   "start": 19.0,
   "end": 22.4,
   "text": "그런데 4월 14일 밤,\n빙산에 옆구리가 긁혔어요"
  },
  {
   "start": 22.4,
   "end": 25.8,
   "text": "물이 들어온 칸은 여섯 칸.\n한계를 넘은 거예요"
  },
  {
   "start": 26.0,
   "end": 29.4,
   "text": "문제는 칸막이 벽 꼭대기가\n뚫려 있었다는 것"
  },
  {
   "start": 29.4,
   "end": 32.8,
   "text": "앞이 가라앉자 물이\n얼음틀처럼 다음 칸으로 넘쳤어요"
  },
  {
   "start": 33.0,
   "end": 36.4,
   "text": "구명보트는 20척,\n1,178명분뿐이었어요"
  },
  {
   "start": 36.4,
   "end": 39.8,
   "text": "배에는 2,200명이 넘게\n타고 있었는데 말이죠"
  },
  {
   "start": 40.0,
   "end": 43.4,
   "text": "결국 배는 둘로 부러져\n바다 밑으로 사라졌어요"
  },
  {
   "start": 43.4,
   "end": 46.8,
   "text": "약 1,500명이\n돌아오지 못했죠"
  },
  {
   "start": 47.0,
   "end": 50.4,
   "text": "이 사고 뒤 모든 승객이 탈\n구명보트를 싣게 됐고"
  },
  {
   "start": 50.4,
   "end": 53.8,
   "text": "빙산을 지켜보는\n국제 빙산 순찰대도 생겼어요"
  },
  {
   "start": 54.0,
   "end": 57.6,
   "text": "퀴즈! 타이타닉은 사고 뒤\n몇 년 만에 발견됐을까?"
  },
  {
   "start": 57.6,
   "end": 60.0,
   "text": "정답은 73년!"
  },
  {
   "start": 60.0,
   "end": 61.8,
   "text": "1985년, 4천 m 바다 밑에서요"
  },
  {
   "start": 62.2,
   "end": 66.0,
   "text": "가라앉지 않는 배는 없다,\n타이타닉이 남긴 교훈이에요"
  },
  {
   "start": 66.2,
   "end": 69.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}