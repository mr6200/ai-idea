 "cues": [
  {
   "start": 0.1,
   "end": 2.6,
   "text": "국민연금, 일찍 받을까\n늦게 받을까?"
  },
  {
   "start": 2.6,
   "end": 4.8,
   "text": "답은 몇 살까지\n사느냐에 달렸어요"
  },
  {
   "start": 5.0,
   "end": 8.4,
   "text": "1969년생부터 국민연금은\n65세에 받아요"
  },
  {
   "start": 8.4,
   "end": 11.8,
   "text": "하지만 60세로 당기거나\n70세까지 늦출 수도 있죠"
  },
  {
   "start": 12.0,
   "end": 15.4,
   "text": "당겨 받으면 1년에 6%씩,\n5년이면 30%가 깎이고"
  },
  {
   "start": 15.4,
   "end": 18.8,
   "text": "늦춰 받으면 1년에 7.2%씩,\n5년이면 36%가 늘어요"
  },
  {
   "start": 19.0,
   "end": 22.4,
   "text": "월 100만 원이라면\n60세부터는 70만 원"
  },
  {
   "start": 22.4,
   "end": 25.8,
   "text": "65세부터는 100만 원,\n70세부터는 136만 원이에요"
  },
  {
   "start": 26.0,
   "end": 29.4,
   "text": "그럼 받은 돈을\n다 더해 볼까요?"
  },
  {
   "start": 29.4,
   "end": 32.8,
   "text": "물가나 이자는 빼고\n단순하게 계산해요"
  },
  {
   "start": 33.0,
   "end": 36.8,
   "text": "일찍 받으면 처음엔\n5년 먼저 받아 앞서지만"
  },
  {
   "start": 36.8,
   "end": 40.8,
   "text": "약 77세가 되면\n65세부터 받은 사람에게 역전돼요"
  },
  {
   "start": 41.0,
   "end": 44.4,
   "text": "늦게 받으면\n기다린 5년만큼 뒤처지다가"
  },
  {
   "start": 44.4,
   "end": 47.8,
   "text": "약 84세부터\n앞서기 시작해요"
  },
  {
   "start": 48.0,
   "end": 51.4,
   "text": "65세 한국인은 평균\n21.7년을 더 살아요"
  },
  {
   "start": 51.4,
   "end": 54.8,
   "text": "약 87세까지니까, 평균만 보면\n늦게 받는 쪽이 유리하죠"
  },
  {
   "start": 55.0,
   "end": 58.4,
   "text": "하지만 건강이 걱정되거나\n당장 생활비가 급하다면"
  },
  {
   "start": 58.4,
   "end": 61.8,
   "text": "일찍 받는 게\n나을 수도 있어요"
  },
  {
   "start": 62.0,
   "end": 65.8,
   "text": "주의할 점! 연금 같은 소득이\n1년에 2,000만 원을 넘으면"
  },
  {
   "start": 65.8,
   "end": 69.8,
   "text": "건강보험 피부양자에서 빠져\n건보료를 내야 할 수 있어요"
  },
  {
   "start": 70.0,
   "end": 73.6,
   "text": "퀴즈! 당겨 받아 깎인 연금,\n65세가 지나면 원래대로 돌아올까?"
  },
  {
   "start": 73.6,
   "end": 76.6,
   "text": "정답은 X!"
  },
  {
   "start": 76.6,
   "end": 79.8,
   "text": "한 번 깎인 금액은\n평생 그대로예요"
  },
  {
   "start": 80.2,
   "end": 84.6,
   "text": "내 건강과 생활비를 따져\n받는 나이를 골라 보세요"
  },
  {
   "start": 84.8,
   "end": 89.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}