 "cues": [
  {
   "start": 0.1,
   "end": 2.6,
   "text": "예금 이자 100만 원,\n다 내 돈일까요?"
  },
  {
   "start": 2.6,
   "end": 4.8,
   "text": "아니요, 15만 4천 원은\n세금이에요"
  },
  {
   "start": 5.0,
   "end": 8.0,
   "text": "이자에는\n15.4% 세금이 붙어요"
  },
  {
   "start": 8.0,
   "end": 10.8,
   "text": "소득세 14%에,\n지방소득세 1.4%"
  },
  {
   "start": 11.0,
   "end": 14.4,
   "text": "은행이 이자를 줄 때\n미리 떼고 줘요"
  },
  {
   "start": 14.4,
   "end": 17.8,
   "text": "그래서 통장엔\n84만 6천 원이 들어와요"
  },
  {
   "start": 18.0,
   "end": 21.4,
   "text": "이자와 배당이\n1년에 2천만 원을 넘으면"
  },
  {
   "start": 21.4,
   "end": 24.8,
   "text": "다른 소득과 합쳐\n세금을 더 낼 수도 있어요"
  },
  {
   "start": 25.0,
   "end": 27.8,
   "text": "세금을 줄이는 방법은\n없을까요?"
  },
  {
   "start": 27.8,
   "end": 30.8,
   "text": "대표적인 두 가지가 있어요"
  },
  {
   "start": 31.0,
   "end": 33.8,
   "text": "첫째, ISA 계좌"
  },
  {
   "start": 33.8,
   "end": 37.6,
   "text": "이익 200만 원까지 세금이 없고,\n서민형은 400만 원"
  },
  {
   "start": 37.6,
   "end": 40.8,
   "text": "넘는 부분도\n9.9%만 내요"
  },
  {
   "start": 41.0,
   "end": 43.8,
   "text": "단, 3년은 유지해야 해요"
  },
  {
   "start": 43.8,
   "end": 46.8,
   "text": "중간에 깨면\n혜택이 사라져요"
  },
  {
   "start": 47.0,
   "end": 50.6,
   "text": "둘째, 농협, 신협, 새마을금고 같은\n상호금융"
  },
  {
   "start": 50.6,
   "end": 54.8,
   "text": "조합원이 되면\n3천만 원까지 세금이 1.4%"
  },
  {
   "start": 55.0,
   "end": 58.6,
   "text": "다만 2026년부터\n소득이 높은 준조합원은"
  },
  {
   "start": 58.6,
   "end": 61.8,
   "text": "세금이 조금씩 늘어요"
  },
  {
   "start": 62.0,
   "end": 65.6,
   "text": "정리하면,\n이자에는 15.4%"
  },
  {
   "start": 65.6,
   "end": 69.8,
   "text": "ISA와 상호금융으로\n세금을 줄일 수 있어요"
  },
  {
   "start": 70.0,
   "end": 73.4,
   "text": "퀴즈! 이자 50만 원,\n세금 떼면 얼마?"
  },
  {
   "start": 73.4,
   "end": 76.4,
   "text": "정답은 42만 3천 원!"
  },
  {
   "start": 76.6,
   "end": 79.8,
   "text": "7만 7천 원이 세금이죠"
  },
  {
   "start": 80.2,
   "end": 84.6,
   "text": "가입 전엔 상품설명서로\n세금 조건을 꼭 확인하세요"
  },
  {
   "start": 84.8,
   "end": 89.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}