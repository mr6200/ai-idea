 "cues": [
  {
   "start": 0.1,
   "end": 3.9,
   "text": "1872년 대서양 한가운데,\n유령선이 발견됐어요"
  },
  {
   "start": 4.0,
   "end": 6.1,
   "text": "배는 멀쩡한데\n사람만 사라졌죠"
  },
  {
   "start": 6.5,
   "end": 9.8,
   "text": "12월 4일, 지나던 배가\n홀로 떠도는 배를 만났어요"
  },
  {
   "start": 9.9,
   "end": 11.4,
   "text": "올라가 보니\n아무도 없었어요"
  },
  {
   "start": 11.8,
   "end": 14.7,
   "text": "선장과 아내, 두 살 딸까지\n열 명이 사라졌어요"
  },
  {
   "start": 14.8,
   "end": 17.8,
   "text": "그런데 배에는 여섯 달 치\n식량과 물이 그대로"
  },
  {
   "start": 17.9,
   "end": 20.9,
   "text": "짐칸의 술통 1,701개도\n거의 그대로였어요"
  },
  {
   "start": 21.3,
   "end": 24.7,
   "text": "따뜻한 찻잔이 남아 있었다는\n이야기, 들어 보셨나요?"
  },
  {
   "start": 24.8,
   "end": 26.3,
   "text": "사실 그런 기록은\n없어요"
  },
  {
   "start": 26.4,
   "end": 30.7,
   "text": "셜록 홈스 작가 코난 도일의\n1884년 소설과 함께 퍼진 이야기죠"
  },
  {
   "start": 31.1,
   "end": 33.1,
   "text": "정말 없어진 건\n작은 구명보트 하나,"
  },
  {
   "start": 33.2,
   "end": 35.3,
   "text": "그리고 항해 도구와\n배 서류들이었어요"
  },
  {
   "start": 35.4,
   "end": 37.8,
   "text": "스스로 배를 버리고\n떠났을 가능성이 크다는 뜻이죠"
  },
  {
   "start": 38.2,
   "end": 41.6,
   "text": "당시 법정은 살인을 의심하고\n배를 꼼꼼히 조사했어요"
  },
  {
   "start": 41.7,
   "end": 44.7,
   "text": "하지만 석 달 넘게 따져 봐도\n범죄 흔적은 찾지 못했죠"
  },
  {
   "start": 45.1,
   "end": 47.4,
   "text": "짐칸엔 바닷물이\n1미터 넘게 차 있었고"
  },
  {
   "start": 47.5,
   "end": 50.2,
   "text": "새어 나온 술 냄새에 폭발을\n걱정했다는 추측도 있어요"
  },
  {
   "start": 50.3,
   "end": 52.5,
   "text": "그리고 열 명은\n끝내 돌아오지 않았어요"
  },
  {
   "start": 52.9,
   "end": 55.5,
   "text": "150년이 지난 지금도\n풀리지 않은 수수께끼예요"
  },
  {
   "start": 55.6,
   "end": 58.1,
   "text": "더 많은 미스터리가 궁금하다면\n구독해 주세요"
  }
 ]
}