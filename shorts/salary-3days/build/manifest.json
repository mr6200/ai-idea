 "cues": [
  {
   "start": 0.1,
   "end": 2.7,
   "text": "월급날 들어온 돈,\n3일 만에 텅 빈 적 있나요?"
  },
  {
   "start": 2.8,
   "end": 3.9,
   "text": "단순히 기분 탓이 아니에요"
  },
  {
   "start": 4.0,
   "end": 6.6,
   "text": "월급이 들어오자마자\n빠져나갈 돈들이 줄을 서 있거든요"
  },
  {
   "start": 6.8,
   "end": 10.4,
   "text": "월세와 관리비, 대출 이자,\n보험료와 통신비까지"
  },
  {
   "start": 10.6,
   "end": 14.2,
   "text": "자동이체가 월급날 바로 뒤에\n몰려 있는 경우가 많죠"
  },
  {
   "start": 14.4,
   "end": 16.8,
   "text": "그리고 가장 큰 건 카드값이에요"
  },
  {
   "start": 17.0,
   "end": 19.4,
   "text": "이번 달 월급으로\n지난달 쓴 돈을 메우는 셈이죠"
  },
  {
   "start": 19.6,
   "end": 23.6,
   "text": "실제로 우리나라 가구는\n쓸 수 있는 돈의 약 69%를 소비해요"
  },
  {
   "start": 23.8,
   "end": 25.4,
   "text": "그럼 어떻게 해야 할까요?"
  },
  {
   "start": 25.6,
   "end": 28.0,
   "text": "월급날, 저축할 돈부터\n먼저 떼어 놓으세요"
  },
  {
   "start": 28.2,
   "end": 30.8,
   "text": "통장을 생활비와\n고정 지출로 나누면\n돈의 흐름이 보여요"
  },
  {
   "start": 31.0,
   "end": 34.6,
   "text": "퀴즈! 카드 결제일이 14일이면\n언제 쓴 돈이 청구될까?"
  },
  {
   "start": 35.4,
   "end": 37.6,
   "text": "정답은, 지난달 1일부터 말일까지!"
  },
  {
   "start": 37.8,
   "end": 40.6,
   "text": "카드사마다 조금 다르니\n앱에서 꼭 확인해 보세요"
  },
  {
   "start": 41.0,
   "end": 42.8,
   "text": "다음 월급은\n사흘보다 오래 버텨 봐요"
  },
  {
   "start": 43.2,
   "end": 45.6,
   "text": "더 많은 돈 이야기가 궁금하다면\n구독해 주세요"
  }
 ]
}