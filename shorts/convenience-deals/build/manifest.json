 "cues": [
  {
   "start": 0.1,
   "end": 3.0,
   "text": "편의점 1+1,\n무조건 이득일까요?"
  },
  {
   "start": 3.0,
   "end": 4.4,
   "text": "계산해 보면\n생각과 달라요"
  },
  {
   "start": 4.6,
   "end": 8.2,
   "text": "1+1은 한 개 값에 두 개,\n반값에 사는 셈이죠"
  },
  {
   "start": 8.2,
   "end": 11.2,
   "text": "그런데 편의점 정가는\n대형마트보다 비싼 편이에요"
  },
  {
   "start": 11.2,
   "end": 15.0,
   "text": "같은 상품 10개를 사 보니\n편의점이 약 37% 더 비쌌죠"
  },
  {
   "start": 15.0,
   "end": 18.4,
   "text": "그래서 1+1이라도\n마트보다 크게 싸지 않을 수 있어요"
  },
  {
   "start": 18.6,
   "end": 22.0,
   "text": "2+1은 더 조심해야 해요,\n세 개를 다 사야 할인이거든요"
  },
  {
   "start": 22.0,
   "end": 23.9,
   "text": "하나만 필요했다면\n두 배를 쓴 셈이죠"
  },
  {
   "start": 24.0,
   "end": 26.4,
   "text": "그래도 끌리는 건\n공짜의 힘 때문이에요"
  },
  {
   "start": 26.4,
   "end": 29.4,
   "text": "미국 실험에서 초콜릿 값을\n1센트 내려 공짜로 만들자"
  },
  {
   "start": 29.4,
   "end": 32.6,
   "text": "더 좋은 초콜릿 대신\n공짜를 고른 사람이 크게 늘었어요"
  },
  {
   "start": 32.8,
   "end": 38.6,
   "text": "참기름 값을 4,750원에서\n9,500원으로 올리고\n1+1을 한 마트도 있었죠"
  },
  {
   "start": 38.6,
   "end": 41.1,
   "text": "공정거래위원회가\n대형마트 4곳에 과징금을 매겼죠"
  },
  {
   "start": 41.2,
   "end": 44.4,
   "text": "퀴즈! 2+1으로 사면\n한 개에 몇 % 할인일까?"
  },
  {
   "start": 45.2,
   "end": 47.6,
   "text": "정답은, 약 33%예요!"
  },
  {
   "start": 47.8,
   "end": 50.2,
   "text": "세 개를\n두 개 값에 사니까요"
  },
  {
   "start": 50.6,
   "end": 53.2,
   "text": "필요한 만큼만,\n한 개 가격을 따져 보세요"
  },
  {
   "start": 53.6,
   "end": 56.6,
   "text": "더 많은 돈 이야기가 궁금하다면\n구독해 주세요"
  }
 ]
}