 "cues": [
  {
   "start": 0.1,
   "end": 2.6,
   "text": "국민연금, 낸 돈보다\n더 받을 수 있을까?"
  },
  {
   "start": 2.6,
   "end": 4.8,
   "text": "기금이 바닥난다는데,\n손해 아닐까요?"
  },
  {
   "start": 5.0,
   "end": 8.4,
   "text": "올해부터 보험료율이\n오르기 시작했어요"
  },
  {
   "start": 8.4,
   "end": 11.8,
   "text": "해마다 조금씩 올라서\n2033년에는 13%가 돼요"
  },
  {
   "start": 12.0,
   "end": 15.4,
   "text": "대신 받는 돈의 비율인\n소득대체율은 43%로 올랐죠"
  },
  {
   "start": 15.4,
   "end": 18.8,
   "text": "더 내고 더 받는\n개혁이에요"
  },
  {
   "start": 19.0,
   "end": 22.4,
   "text": "그럼 받는 돈을\n낸 돈으로 나눠 볼까요?"
  },
  {
   "start": 22.4,
   "end": 25.8,
   "text": "이 비율을\n수익비라고 불러요"
  },
  {
   "start": 26.0,
   "end": 29.4,
   "text": "평균 소득자라면 개혁 뒤에도\n낸 돈의 약 1.6에서 2배"
  },
  {
   "start": 29.4,
   "end": 32.8,
   "text": "젊은 세대일수록\n조금 낮아지긴 해요"
  },
  {
   "start": 33.0,
   "end": 36.8,
   "text": "어떻게 더 줄 수 있을까요?\n첫째, 매년 물가만큼 올라요"
  },
  {
   "start": 36.8,
   "end": 40.8,
   "text": "올해도\n2.1% 올랐죠"
  },
  {
   "start": 41.0,
   "end": 44.4,
   "text": "둘째, 직장인은 보험료 절반을\n회사가 내 줘요"
  },
  {
   "start": 44.4,
   "end": 47.8,
   "text": "셋째, 소득이 적을수록\n더 많이 돌려받는 구조예요"
  },
  {
   "start": 48.0,
   "end": 51.4,
   "text": "그럼 기금이 바닥나면\n어떻게 될까요?"
  },
  {
   "start": 51.4,
   "end": 54.8,
   "text": "개혁으로 소진 시점은\n2064년쯤으로 늦춰졌어요"
  },
  {
   "start": 55.0,
   "end": 58.4,
   "text": "그리고 이제 법에, 국가가\n지급을 보장한다고 적혔어요"
  },
  {
   "start": 58.4,
   "end": 61.8,
   "text": "2026년 1월부터\n시행됐죠"
  },
  {
   "start": 62.0,
   "end": 65.8,
   "text": "정리하면, 낸 돈보다\n더 받는 구조예요"
  },
  {
   "start": 65.8,
   "end": 69.8,
   "text": "오랫동안 꾸준히 낼수록\n더 유리하고요"
  },
  {
   "start": 70.0,
   "end": 73.6,
   "text": "퀴즈! 국민연금 수령액은\n매년 무엇에 맞춰 오를까?"
  },
  {
   "start": 73.6,
   "end": 76.6,
   "text": "정답은 물가!"
  },
  {
   "start": 76.6,
   "end": 79.8,
   "text": "소비자물가 상승률만큼\n올라요"
  },
  {
   "start": 80.2,
   "end": 84.6,
   "text": "노후 준비의 첫걸음,\n국민연금부터 챙겨 보세요"
  },
  {
   "start": 84.8,
   "end": 89.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}