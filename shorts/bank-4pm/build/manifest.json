 "cues": [
  {
   "start": 0.1,
   "end": 1.9,
   "text": "은행은 왜 4시면\n문을 닫을까요?"
  },
  {
   "start": 2.0,
   "end": 3.6,
   "text": "직원들이 일찍 퇴근하는 걸까요?"
  },
  {
   "start": 3.7,
   "end": 4.8,
   "text": "사실은 정반대예요"
  },
  {
   "start": 5.0,
   "end": 7.6,
   "text": "셔터가 내려가면 그때부터\n진짜 마감이 시작돼요"
  },
  {
   "start": 7.8,
   "end": 10.8,
   "text": "은행원들은 그날 오간 현금을\n1원까지 맞춰 봐야 하거든요"
  },
  {
   "start": 11.3,
   "end": 14.0,
   "text": "안 맞으면 하루치 거래 내역을\n하나하나 다시 살펴요"
  },
  {
   "start": 14.2,
   "end": 17.8,
   "text": "수표와 세금 정리, 대출 서류까지,\n밤늦게 끝나는 날도 있죠"
  },
  {
   "start": 18.0,
   "end": 21.2,
   "text": "코로나 때는 9시 반부터\n3시 반까지로 줄었다가"
  },
  {
   "start": 21.4,
   "end": 24.6,
   "text": "2023년 1월에\n다시 9시부터 4시로 돌아왔어요"
  },
  {
   "start": 24.8,
   "end": 27.0,
   "text": "그런데 내년 4월부터는\n문을 30분 늦게 열어요"
  },
  {
   "start": 27.2,
   "end": 30.0,
   "text": "오전 9시 반에 열고,\n닫는 시간은 그대로 4시예요"
  },
  {
   "start": 30.4,
   "end": 33.6,
   "text": "퀴즈! 4시가 넘어 급한 은행 일은\n어디로 가야 할까?"
  },
  {
   "start": 34.4,
   "end": 36.1,
   "text": "정답은, 탄력점포예요!"
  },
  {
   "start": 36.3,
   "end": 39.4,
   "text": "저녁이나 주말에도 여는 점포를\n은행연합회에서 찾을 수 있어요"
  },
  {
   "start": 40.0,
   "end": 42.4,
   "text": "오늘도 4시 이후, 은행은\n불이 켜져 있어요"
  },
  {
   "start": 42.8,
   "end": 45.2,
   "text": "더 많은 돈 이야기가 궁금하다면\n구독해 주세요"
  }
 ]
}