 "cues": [
  {
   "start": 0.1,
   "end": 2.6,
   "text": "집은 있는데\n현금이 없다면?"
  },
  {
   "start": 2.6,
   "end": 4.8,
   "text": "집으로 월급을\n받는 방법이 있어요"
  },
  {
   "start": 5.0,
   "end": 8.4,
   "text": "바로 주택연금.\n집을 담보로 매달 연금을 받아요"
  },
  {
   "start": 8.4,
   "end": 11.8,
   "text": "그러면서 그 집에\n계속 살 수 있죠"
  },
  {
   "start": 12.0,
   "end": 15.4,
   "text": "가입 조건은 부부 중 한 명이\n만 55세 이상"
  },
  {
   "start": 15.4,
   "end": 18.8,
   "text": "집값은 공시가격\n12억 원 이하예요"
  },
  {
   "start": 19.0,
   "end": 22.4,
   "text": "그럼 얼마나 받을까요?\n72세, 4억 원 집이라면"
  },
  {
   "start": 22.4,
   "end": 25.8,
   "text": "매달 약 133만 원을\n평생 받아요"
  },
  {
   "start": 26.0,
   "end": 29.4,
   "text": "나이가 많을수록,\n집값이 비쌀수록 더 받아요"
  },
  {
   "start": 29.4,
   "end": 32.8,
   "text": "올해 3월부터는\n평균 3% 넘게 올랐죠"
  },
  {
   "start": 33.0,
   "end": 36.8,
   "text": "장점은? 부부 중 한 명이\n먼저 떠나도"
  },
  {
   "start": 36.8,
   "end": 40.8,
   "text": "남은 배우자가 같은 금액을\n계속 받아요"
  },
  {
   "start": 41.0,
   "end": 44.4,
   "text": "집값이 떨어져도\n연금은 그대로"
  },
  {
   "start": 44.4,
   "end": 47.8,
   "text": "나라가 지급을\n책임지거든요"
  },
  {
   "start": 48.0,
   "end": 51.4,
   "text": "나중에 집을 팔아 정산할 때\n돈이 남으면 자녀에게"
  },
  {
   "start": 51.4,
   "end": 54.8,
   "text": "모자라도 자녀에게\n청구하지 않아요"
  },
  {
   "start": 55.0,
   "end": 58.4,
   "text": "하지만 단점도 있어요.\n받은 연금에 이자가 붙어서"
  },
  {
   "start": 58.4,
   "end": 61.8,
   "text": "집을 물려주기는\n어려워질 수 있죠"
  },
  {
   "start": 62.0,
   "end": 65.8,
   "text": "집값이 올라도\n연금은 늘지 않고"
  },
  {
   "start": 65.8,
   "end": 69.8,
   "text": "중간에 그만두면\n받은 돈과 이자를 갚아야 해요"
  },
  {
   "start": 70.0,
   "end": 73.6,
   "text": "퀴즈! 해지하고 같은 집으로\n바로 다시 가입할 수 있을까?"
  },
  {
   "start": 73.6,
   "end": 76.6,
   "text": "정답은 X!"
  },
  {
   "start": 76.6,
   "end": 79.8,
   "text": "같은 집으로는\n3년 동안 다시 못 해요"
  },
  {
   "start": 80.2,
   "end": 84.6,
   "text": "집 한 채가 노후 월급이 되는\n주택연금, 꼼꼼히 따져 보세요"
  },
  {
   "start": 84.8,
   "end": 89.8,
   "text": "더 많은 지식이 궁금하다면\n구독해 주세요"
  }
 ]
}